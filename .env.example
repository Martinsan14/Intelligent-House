# Copy to .env; Node loads it with npm start.
PORT=3000
HOST=127.0.0.1
# demo simulates devices; mqtt requires the broker and firmware.
CONTROL_MODE=demo
# Required in mqtt mode; generate a long random password and session secret.
ADMIN_PASSWORD=
SESSION_SECRET=
# mqtts only; never expose the ESP32 or broker publicly without authentication.
MQTT_URL=mqtts://your-broker.example:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_HOME_ID=my-house
# Set true only behind your trusted HTTPS reverse proxy.
SECURE_COOKIES=false
ENABLE_MAIN_POWER=false
# Optional persistent name storage path; default is data/light-names.json.
# LIGHT_NAMES_FILE=/your/persistent-volume/light-names.json
